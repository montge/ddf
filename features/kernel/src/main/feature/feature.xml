<features xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          name="${project.artifactId}-${project.version}"
          xmlns="http://karaf.apache.org/xmlns/features/v1.3.0"
          xsi:schemaLocation="http://karaf.apache.org/xmlns/features/v1.3.0 http://karaf.apache.org/xmlns/features/v1.3.0">

    <repository>mvn:org.apache.karaf.features/standard/${karaf.version}/xml/features</repository>
    <repository>mvn:org.apache.karaf.features/specs/${karaf.version}/xml/features</repository>
    <repository>mvn:org.ops4j.pax.web/pax-web-features/${pax.web.version}/xml/features</repository>
    <!-- Note: We do NOT include Karaf's spring repository here to avoid duplication.
         Our spring features below provide Spring 6.2.8 via ServiceMix OSGi bundles. -->

    <!--
        Spring 6.2.x features for DDF (overrides Karaf's default Spring 6.1.x features).

        SECURITY: Spring 6.2.11 fixes CVE-2025-41249 (annotation-detection). Apache ServiceMix
        never published an OSGi bundle past 6.2.8_1 (still vulnerable), so instead of the
        ServiceMix bundles DDF wraps the OFFICIAL org.springframework:*:${spring.version} jars
        via Karaf's wrap: protocol (Spring 6.x ships no OSGi manifest of its own). Imports are
        declared optional so Spring resolves against whatever the DDF runtime already provides —
        the same dependency set the prior 6.2.8 bundles used (a patch-level bump adds no new
        required packages). CVE-2025-41254 (STOMP CSRF) needs 6.2.12 — revisit then.

        RUNTIME VALIDATION REQUIRED: the wrap metadata below is validated for STRUCTURE at build
        time only. OSGi resolution/binding must be confirmed on a running Karaf instance before
        this is trusted in production (blocked locally by the distribution/docs build issue).

        Two versions are provided:
        - 0.0.0 (default) for unversioned <feature>spring</feature> references
        - ${spring.osgi.bundle.version} for explicit version references (e.g. from Camel)
    -->
    <!-- Default spring feature (version 0.0.0) that delegates to the versioned one -->
    <feature name="spring" description="Spring 6.2.x support (default)" version="0.0.0">
        <feature version="${spring.osgi.bundle.version}">spring</feature>
    </feature>

    <!-- Versioned spring feature for explicit version references -->
    <feature name="spring" description="Spring 6.2.x support" version="${spring.osgi.bundle.version}">
        <bundle dependency="true" start-level="30">mvn:org.apache.servicemix.bundles/org.apache.servicemix.bundles.aopalliance/1.0_6</bundle>
        <bundle start-level="30">wrap:mvn:org.springframework/spring-core/${spring.version}$Bundle-SymbolicName=org.springframework.spring-core&amp;Bundle-Version=${spring.version}&amp;Export-Package=org.springframework.*;version=${spring.version}&amp;Import-Package=*;resolution:=optional</bundle>
        <bundle start-level="30">wrap:mvn:org.springframework/spring-expression/${spring.version}$Bundle-SymbolicName=org.springframework.spring-expression&amp;Bundle-Version=${spring.version}&amp;Export-Package=org.springframework.*;version=${spring.version}&amp;Import-Package=*;resolution:=optional</bundle>
        <bundle start-level="30">wrap:mvn:org.springframework/spring-beans/${spring.version}$Bundle-SymbolicName=org.springframework.spring-beans&amp;Bundle-Version=${spring.version}&amp;Export-Package=org.springframework.*;version=${spring.version}&amp;Import-Package=*;resolution:=optional</bundle>
        <bundle start-level="30">wrap:mvn:org.springframework/spring-aop/${spring.version}$Bundle-SymbolicName=org.springframework.spring-aop&amp;Bundle-Version=${spring.version}&amp;Export-Package=org.springframework.*;version=${spring.version}&amp;Import-Package=*;resolution:=optional</bundle>
        <bundle start-level="30">wrap:mvn:org.springframework/spring-context/${spring.version}$Bundle-SymbolicName=org.springframework.spring-context&amp;Bundle-Version=${spring.version}&amp;Export-Package=org.springframework.*;version=${spring.version}&amp;Import-Package=*;resolution:=optional</bundle>
        <bundle start-level="30">wrap:mvn:org.springframework/spring-context-support/${spring.version}$Bundle-SymbolicName=org.springframework.spring-context-support&amp;Bundle-Version=${spring.version}&amp;Export-Package=org.springframework.*;version=${spring.version}&amp;Import-Package=*;resolution:=optional</bundle>
    </feature>

    <feature name="spring-tx" description="Spring 6.2.x Transaction (TX) support" version="${spring.osgi.bundle.version}">
        <feature version="${spring.osgi.bundle.version}">spring</feature>
        <bundle start-level="30">wrap:mvn:org.springframework/spring-tx/${spring.version}$Bundle-SymbolicName=org.springframework.spring-tx&amp;Bundle-Version=${spring.version}&amp;Export-Package=org.springframework.*;version=${spring.version}&amp;Import-Package=*;resolution:=optional</bundle>
    </feature>

    <feature name="spring-jdbc" description="Spring 6.2.x JDBC support" version="${spring.osgi.bundle.version}">
        <feature version="${spring.osgi.bundle.version}">spring-tx</feature>
        <bundle start-level="30">wrap:mvn:org.springframework/spring-jdbc/${spring.version}$Bundle-SymbolicName=org.springframework.spring-jdbc&amp;Bundle-Version=${spring.version}&amp;Export-Package=org.springframework.*;version=${spring.version}&amp;Import-Package=*;resolution:=optional</bundle>
    </feature>

    <feature name="spring-orm" description="Spring 6.2.x ORM support" version="${spring.osgi.bundle.version}">
        <feature version="${spring.osgi.bundle.version}">spring-jdbc</feature>
        <bundle start-level="30">wrap:mvn:org.springframework/spring-orm/${spring.version}$Bundle-SymbolicName=org.springframework.spring-orm&amp;Bundle-Version=${spring.version}&amp;Export-Package=org.springframework.*;version=${spring.version}&amp;Import-Package=*;resolution:=optional</bundle>
    </feature>

    <feature name="spring-jms" description="Spring 6.2.x JMS support" version="${spring.osgi.bundle.version}">
        <feature version="${spring.osgi.bundle.version}">spring-tx</feature>
        <bundle start-level="30">wrap:mvn:org.springframework/spring-jms/${spring.version}$Bundle-SymbolicName=org.springframework.spring-jms&amp;Bundle-Version=${spring.version}&amp;Export-Package=org.springframework.*;version=${spring.version}&amp;Import-Package=*;resolution:=optional</bundle>
    </feature>

    <feature name="spring-oxm" description="Spring 6.2.x OXM support" version="${spring.osgi.bundle.version}">
        <feature version="${spring.osgi.bundle.version}">spring</feature>
        <bundle start-level="30">wrap:mvn:org.springframework/spring-oxm/${spring.version}$Bundle-SymbolicName=org.springframework.spring-oxm&amp;Bundle-Version=${spring.version}&amp;Export-Package=org.springframework.*;version=${spring.version}&amp;Import-Package=*;resolution:=optional</bundle>
    </feature>

    <feature name="spring-test" description="Spring 6.2.x Test support" version="${spring.osgi.bundle.version}">
        <feature version="${spring.osgi.bundle.version}">spring</feature>
        <bundle start-level="30">wrap:mvn:org.springframework/spring-test/${spring.version}$Bundle-SymbolicName=org.springframework.spring-test&amp;Bundle-Version=${spring.version}&amp;Export-Package=org.springframework.*;version=${spring.version}&amp;Import-Package=*;resolution:=optional</bundle>
    </feature>

    <feature name="spring-web" description="Spring 6.2.x Web support" version="${spring.osgi.bundle.version}">
        <feature version="${spring.osgi.bundle.version}">spring</feature>
        <bundle start-level="30">wrap:mvn:org.springframework/spring-web/${spring.version}$Bundle-SymbolicName=org.springframework.spring-web&amp;Bundle-Version=${spring.version}&amp;Export-Package=org.springframework.*;version=${spring.version}&amp;Import-Package=*;resolution:=optional</bundle>
        <bundle start-level="30">wrap:mvn:org.springframework/spring-webmvc/${spring.version}$Bundle-SymbolicName=org.springframework.spring-webmvc&amp;Bundle-Version=${spring.version}&amp;Export-Package=org.springframework.*;version=${spring.version}&amp;Import-Package=*;resolution:=optional</bundle>
    </feature>

    <feature name="kernel" version="${project.version}"
             description="Minimal set of features and dependencies commonly used.">
        <feature version="${karaf.version}">standard</feature>
        <feature version="${karaf.version}">eventadmin</feature>
        <feature version="${karaf.version}">jasypt-encryption</feature>
        <feature version="${karaf.version}">pax-web-http-war</feature>
        <feature version="${pax.web.version}">pax-web-karaf</feature>
        <bundle>mvn:javax.servlet/javax.servlet-api/${javax.servlet-api.version}</bundle>
        <!-- Jakarta Servlet 6.x API for CXF 4.x and other Jakarta EE 10+ libraries -->
        <feature>jakarta-servlet-api</feature>
        <!--Added wrap at the end so features before this can startup up while we block on the wrap feature-->
        <feature prerequisite="true">wrap</feature>
    </feature>

    <feature name="sync-installer" version="${project.version}">
        <bundle>mvn:ddf.platform/sync-installer-api/${project.version}</bundle>
        <bundle>mvn:ddf.platform/sync-installer-impl/${project.version}</bundle>
    </feature>

    <feature name="javax-validation" version="${project.version}">
        <bundle>mvn:jakarta.validation/jakarta.validation-api/${validation.version}</bundle>
    </feature>

    <feature name="joda-converter" version="${project.version}">
        <bundle>mvn:org.joda/joda-convert/${joda-convert.version}</bundle>
    </feature>

    <feature name="javax-inject" version="${project.version}">
        <bundle>
            mvn:org.apache.servicemix.bundles/org.apache.servicemix.bundles.javax-inject/${javax.inject.bundle.version}
        </bundle>
    </feature>

    <feature name="slf4j" version="${project.version}">
        <bundle>mvn:org.codice.thirdparty/cal10n-api/${cal10n.thirdparty.bundle.version}</bundle>
        <bundle>mvn:org.slf4j/slf4j-ext/${org.slf4j.version}</bundle>
        <!-- Note: SLF4J API is provided by Pax Logging (version 2.0.6)
             solr-dependencies uses version range [2.0,3.0) to accept this -->
    </feature>

    <!-- Note: Log4j API is provided by pax-logging-api at version 2.24.3.
         Do NOT add a separate log4j-api bundle as it will conflict with pax-logging.
         Bundles requiring log4j should import with version range [2.20,3) to accept
         pax-logging's exports. -->

    <!-- Jakarta EE APIs for CXF 4.x and other Jakarta-based libraries -->
    <feature name="jakarta-servlet-api" version="${project.version}">
        <bundle>mvn:jakarta.servlet/jakarta.servlet-api/${jakarta.servlet-api.version}</bundle>
    </feature>

    <feature name="pax-swissbox" version="${project.version}">
        <bundle>
            mvn:org.ops4j.pax.swissbox/pax-swissbox-lifecycle/${org.ops4j.pax.swissbox.version}
        </bundle>
        <bundle>mvn:org.ops4j.base/ops4j-base-lang/${org.ops4j.base.version}</bundle>
        <bundle>mvn:org.ops4j.pax.swissbox/pax-swissbox-extender/${org.ops4j.pax.swissbox.version}
        </bundle>
    </feature>

    <feature name="apache-commons" version="${project.version}">
        <bundle>mvn:commons-io/commons-io/${commons-io.version}</bundle>
        <bundle>mvn:commons-lang/commons-lang/${commons-lang.version}</bundle>
        <bundle>mvn:org.apache.commons/commons-lang3/${commons-lang3.version}</bundle>
        <bundle>mvn:org.apache.commons/commons-collections4/${commons-collections4.version}</bundle>
    </feature>

    <feature name="saxon" version="${project.version}">
        <bundle>mvn:org.apache.servicemix.bundles/org.apache.servicemix.bundles.xmlresolver/1.2_5
        </bundle>
        <bundle>
            mvn:org.apache.servicemix.bundles/org.apache.servicemix.bundles.saxon/${saxon.bundle.plugin}
        </bundle>
    </feature>

    <feature name="guava" version="${project.version}">
        <bundle dependency="true">mvn:com.google.guava/failureaccess/1.0.1</bundle>
        <bundle>mvn:com.google.guava/guava/${guava.version}</bundle>
    </feature>

    <feature name="dev-failsafe" version="${project.version}">
        <feature prerequisite="true">wrap</feature>
        <bundle>mvn:dev.failsafe/failsafe/${dev.failsafe.version}</bundle>
    </feature>

    <feature name="kernel-all" version="${project.version}">
        <feature>kernel</feature>
        <feature>sync-installer</feature>
        <feature>javax-validation</feature>
        <feature>joda-converter</feature>
        <feature>javax-inject</feature>
        <feature>slf4j</feature>
        <feature>pax-swissbox</feature>
        <feature>apache-commons</feature>
        <feature>saxon</feature>
        <feature>guava</feature>
        <feature>dev-failsafe</feature>
    </feature>
</features>
