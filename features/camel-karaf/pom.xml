<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>features</artifactId>
        <groupId>ddf.features</groupId>
        <version>2.30.0-SNAPSHOT</version>
    </parent>

    <name>DDF :: Features :: Camel Karaf</name>
    <artifactId>camel-karaf</artifactId>
    <packaging>pom</packaging>

    <properties>
        <setup.folder>${project.build.directory}/dependency</setup.folder>
    </properties>

    <!-- This is a workaround for KARAF-5999/KARAF-7428 -->

    <dependencies>
        <dependency>
            <groupId>org.apache.camel.karaf</groupId>
            <artifactId>apache-camel</artifactId>
            <version>${camel.version}</version>
            <type>xml</type>
            <classifier>features</classifier>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.apache.camel.karaf</groupId>
                                    <artifactId>apache-camel</artifactId>
                                    <version>${camel.version}</version>
                                    <type>xml</type>
                                    <classifier>features</classifier>
                                    <outputDirectory>${setup.folder}</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- Remove the spring-features repository reference since DDF provides
                                     its own Spring features and Camel's spring-features requires
                                     Spring 6.2.11 which doesn't exist yet -->
                                <replaceregexp file="${setup.folder}/apache-camel-${camel.version}-features.xml"
                                    match="&lt;repository&gt;mvn:org\.apache\.camel\.karaf/apache-camel/[^&lt;]+/xml/spring-features&lt;/repository&gt;"
                                    replace=""
                                    flags="g" />
                                <!-- Add Karaf standard/specs features repository references which
                                     define xml-specs-api and other dependencies Camel needs -->
                                <replaceregexp file="${setup.folder}/apache-camel-${camel.version}-features.xml"
                                    match="(&lt;features[^&gt;]*&gt;)"
                                    replace="\1&#10;    &lt;repository&gt;mvn:org.apache.karaf.features/standard/${karaf.version}/xml/features&lt;/repository&gt;&#10;    &lt;repository&gt;mvn:org.apache.karaf.features/specs/${karaf.version}/xml/features&lt;/repository&gt;"
                                    flags="s" />
                                <!-- Remove jakarta-xml-bind 3.0.1 feature definition to avoid conflicts.
                                     All JAXB consumers should use 4.0.2 (jakarta namespace, backwards compatible). -->
                                <replaceregexp file="${setup.folder}/apache-camel-${camel.version}-features.xml"
                                    match="&lt;feature name=&quot;jakarta-xml-bind&quot; version=&quot;3\.0\.1&quot;&gt;[^&lt;]*&lt;feature[^&lt;]*&lt;/feature&gt;[^&lt;]*&lt;bundle[^&lt;]*&lt;/bundle&gt;[^&lt;]*&lt;/feature&gt;"
                                    replace=""
                                    flags="gs" />
                                <!-- Change jaxb-runtime 3.0.2 to use jakarta-xml-bind [4,5) instead of [3,4) -->
                                <replaceregexp file="${setup.folder}/apache-camel-${camel.version}-features.xml"
                                    match="(&lt;feature name=&quot;jaxb-runtime&quot; version=&quot;3\.0\.2&quot;&gt;[^&lt;]*&lt;feature version=&quot;)\[3,4\)(&quot;&gt;jakarta-xml-bind&lt;/feature&gt;)"
                                    replace="\1[4,5)\2"
                                    flags="gs" />
                                <!-- CXF packages are provided by camel-cxf-all (from Camel's camel-cxf feature).
                                     DDF's cxf-core feature no longer installs cxf-core-all to avoid
                                     split-package conflicts that cause LinkageErrors at runtime. -->
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-artifacts</id>
                        <phase>package</phase>
                        <inherited>false</inherited>
                        <goals>
                            <goal>attach-artifact</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <artifact>
                                    <file>target/dependency/apache-camel-${camel.version}-features.xml</file>
                                    <type>xml</type>
                                    <classifier>features</classifier>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
