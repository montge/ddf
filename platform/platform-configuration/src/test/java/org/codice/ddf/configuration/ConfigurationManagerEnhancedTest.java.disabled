package org.codice.ddf.configuration;

import static org.hamcrest.MatcherAssert.assertThat;
import static org.hamcrest.Matchers.is;
import static org.hamcrest.Matchers.notNullValue;
import static org.hamcrest.Matchers.nullValue;
import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;

import java.io.IOException;
import java.util.ArrayList;
import java.util.Dictionary;
import java.util.HashMap;
import java.util.Hashtable;
import java.util.List;
import java.util.Map;
import org.junit.Before;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;
import org.osgi.service.cm.Configuration;
import org.osgi.service.cm.ConfigurationAdmin;

/**
 * Enhanced tests for {@link ConfigurationManager} focusing on coverage of edge cases and lifecycle
 * scenarios.
 *
 * <p>This test suite validates:
 *
 * <ul>
 *   <li>Configuration manager lifecycle operations
 *   <li>ConfigurationAdmin integration
 *   <li>Multiple watcher management
 *   <li>Configuration value retrieval with error handling
 *   <li>Read-only settings management
 *   <li>Null safety throughout the API
 * </ul>
 */
@RunWith(MockitoJUnitRunner.class)
public class ConfigurationManagerEnhancedTest {

  @Mock private ConfigurationAdmin mockConfigAdmin;

  @Mock private Configuration mockConfiguration;

  private ConfigurationManager configManager;
  private List<ConfigurationWatcher> watchers;
  private MockConfigurationWatcher watcher1;
  private MockConfigurationWatcher watcher2;

  @Before
  public void setUp() {
    watcher1 = new MockConfigurationWatcher();
    watcher2 = new MockConfigurationWatcher();
    watchers = new ArrayList<>();
    watchers.add(watcher1);
    watchers.add(watcher2);

    configManager = new ConfigurationManager(watchers, mockConfigAdmin);
  }

  @Test
  public void testConstructorWithNullConfigAdmin() {
    ConfigurationManager manager = new ConfigurationManager(watchers, null);

    assertThat(manager.getConfigurationAdmin(), is(nullValue()));
  }

  @Test
  public void testConstructorWithEmptyWatcherList() {
    List<ConfigurationWatcher> emptyList = new ArrayList<>();
    ConfigurationManager manager = new ConfigurationManager(emptyList, mockConfigAdmin);

    assertThat(manager, is(notNullValue()));
  }

  @Test
  public void testSettersAndGetters() {
    configManager.setProtocol("https");
    configManager.setHost("test.example.com");
    configManager.setPort("8993");
    configManager.setId("testSite");
    configManager.setVersion("2.29.0");
    configManager.setOrganization("Test Organization");
    configManager.setContact("admin@test.com");

    // Values are pushed to watchers via init()
    configManager.init();

    // Verify watchers received the configuration
    assertThat(watcher1.getConfigValue(ConfigurationManager.PROTOCOL), is(notNullValue()));
    assertThat(watcher2.getConfigValue(ConfigurationManager.PROTOCOL), is(notNullValue()));
  }

  @Test
  public void testUpdatedWithNullMap() {
    Map<String, String> initialConfig = new HashMap<>();
    initialConfig.put("test", "value");

    configManager.updated(initialConfig);
    configManager.updated(null);

    // Watchers should still have the previous configuration
    assertThat(watcher1.getConfigValue("test"), is("value"));
  }

  @Test
  public void testUpdatedWithEmptyMap() {
    Map<String, String> initialConfig = new HashMap<>();
    initialConfig.put("test", "value");

    configManager.updated(initialConfig);
    configManager.updated(new HashMap<>());

    // Empty map should not clear existing configuration
    assertThat(watcher1.getConfigValue("test"), is("value"));
  }

  @Test
  public void testUpdatedNotifiesAllWatchers() {
    Map<String, String> config = new HashMap<>();
    config.put("shared.key", "shared.value");

    configManager.updated(config);

    assertThat(watcher1.getConfigValue("shared.key"), is("shared.value"));
    assertThat(watcher2.getConfigValue("shared.key"), is("shared.value"));
  }

  @Test
  public void testBindWithNullWatcher() {
    configManager.bind(null, null);

    // Should not throw exception
  }

  @Test
  public void testBindPushesCurrentConfigurationToNewWatcher() {
    Map<String, String> config = new HashMap<>();
    config.put("existing.key", "existing.value");

    configManager.updated(config);

    MockConfigurationWatcher newWatcher = new MockConfigurationWatcher();
    configManager.bind(newWatcher, null);

    assertThat(newWatcher.getConfigValue("existing.key"), is("existing.value"));
  }

  @Test
  public void testBindWithEmptyProperties() {
    MockConfigurationWatcher newWatcher = new MockConfigurationWatcher();
    Map<String, Object> emptyProps = new HashMap<>();

    configManager.bind(newWatcher, emptyProps);

    // Should receive read-only settings at minimum
    assertThat(newWatcher.getLastConfig(), is(notNullValue()));
  }

  @Test
  public void testConfigurationAdminSetterAndGetter() {
    assertThat(configManager.getConfigurationAdmin(), is(mockConfigAdmin));

    ConfigurationAdmin newAdmin = mock(ConfigurationAdmin.class);
    configManager.setConfigurationAdmin(newAdmin);

    assertThat(configManager.getConfigurationAdmin(), is(newAdmin));
  }

  @Test
  public void testGetConfigurationValueWithValidPid() throws IOException {
    String pid = "test.service.pid";
    String propertyName = "test.property";
    String expectedValue = "test.value";

    Dictionary<String, Object> properties = new Hashtable<>();
    properties.put(propertyName, expectedValue);

    when(mockConfigAdmin.getConfiguration(pid)).thenReturn(mockConfiguration);
    when(mockConfiguration.getProperties()).thenReturn(properties);

    String actualValue = configManager.getConfigurationValue(pid, propertyName);

    assertThat(actualValue, is(expectedValue));
    verify(mockConfigAdmin).getConfiguration(pid);
  }

  @Test
  public void testGetConfigurationValueWithNullConfigAdmin() {
    ConfigurationManager managerWithNullAdmin = new ConfigurationManager(watchers, null);

    String value = managerWithNullAdmin.getConfigurationValue("test.pid", "test.property");

    assertThat(value, is(""));
  }

  @Test
  public void testGetConfigurationValueWithNullConfiguration() throws IOException {
    when(mockConfigAdmin.getConfiguration(anyString())).thenReturn(null);

    String value = configManager.getConfigurationValue("test.pid", "test.property");

    assertThat(value, is(""));
  }

  @Test
  public void testGetConfigurationValueWithNullProperties() throws IOException {
    when(mockConfigAdmin.getConfiguration(anyString())).thenReturn(mockConfiguration);
    when(mockConfiguration.getProperties()).thenReturn(null);

    String value = configManager.getConfigurationValue("test.pid", "test.property");

    assertThat(value, is(""));
  }

  @Test
  public void testGetConfigurationValueWithNonExistentProperty() throws IOException {
    Dictionary<String, Object> properties = new Hashtable<>();
    properties.put("different.property", "value");

    when(mockConfigAdmin.getConfiguration(anyString())).thenReturn(mockConfiguration);
    when(mockConfiguration.getProperties()).thenReturn(properties);

    String value = configManager.getConfigurationValue("test.pid", "missing.property");

    assertThat(value, is(""));
  }

  @Test
  public void testGetConfigurationValueWithIOException() throws IOException {
    when(mockConfigAdmin.getConfiguration(anyString()))
        .thenThrow(new IOException("Test exception"));

    String value = configManager.getConfigurationValue("test.pid", "test.property");

    assertThat(value, is(""));
  }

  @Test
  public void testReadOnlySettingsIncludedInConfiguration() {
    Map<String, String> config = new HashMap<>();
    config.put("user.setting", "user.value");

    configManager.updated(config);

    // Read-only settings like HOME_DIR should be included
    Map<String, String> receivedConfig = watcher1.getLastConfig();
    assertThat(receivedConfig.get("user.setting"), is("user.value"));
    assertThat(receivedConfig.get(ConfigurationManager.HOME_DIR), is(notNullValue()));
  }

  @Test
  public void testConfigurationIncludesSystemProperties() {
    configManager.setProtocol("https");
    configManager.setHost("localhost");
    configManager.setPort("8993");
    configManager.setId("site1");

    configManager.init();

    Map<String, String> config = watcher1.getLastConfig();
    assertThat(config, is(notNullValue()));
    // System properties should be set
    assertThat(config.size() > 0, is(true));
  }

  @Test
  public void testMultipleUpdatesPreserveReadOnlySettings() {
    Map<String, String> config1 = new HashMap<>();
    config1.put("setting1", "value1");

    Map<String, String> config2 = new HashMap<>();
    config2.put("setting2", "value2");

    configManager.updated(config1);
    String homeDir1 = watcher1.getConfigValue(ConfigurationManager.HOME_DIR);

    configManager.updated(config2);
    String homeDir2 = watcher1.getConfigValue(ConfigurationManager.HOME_DIR);

    // Read-only settings should persist across updates
    assertThat(homeDir1, is(homeDir2));
    assertThat(homeDir2, is(notNullValue()));
  }

  @Test
  public void testInitPushesConfigurationToWatchers() {
    configManager.setProtocol("http");
    configManager.setHost("example.com");
    configManager.setPort("8181");

    configManager.init();

    // Both watchers should receive configuration
    assertThat(watcher1.getLastConfig(), is(notNullValue()));
    assertThat(watcher2.getLastConfig(), is(notNullValue()));
  }

  @Test
  public void testUpdatedWithMixedValueTypes() {
    Map<String, Object> config = new HashMap<>();
    config.put("string.prop", "stringValue");
    config.put("int.prop", 12345);
    config.put("boolean.prop", true);

    configManager.updated(config);

    // All values should be converted to strings in the configuration
    Map<String, String> receivedConfig = watcher1.getLastConfig();
    assertThat(receivedConfig.get("string.prop"), is("stringValue"));
    assertThat(receivedConfig.get("int.prop"), is("12345"));
    assertThat(receivedConfig.get("boolean.prop"), is("true"));
  }

  @Test
  public void testUpdatedIgnoresNullValues() {
    Map<String, Object> config = new HashMap<>();
    config.put("valid.key", "valid.value");
    config.put("null.key", null);

    configManager.updated(config);

    Map<String, String> receivedConfig = watcher1.getLastConfig();
    assertThat(receivedConfig.get("valid.key"), is("valid.value"));
    // Null values should be skipped
  }

  @Test
  public void testConfigurationManagerConstants() {
    assertThat(ConfigurationManager.PID, is("ddf.platform.config"));
    assertThat(ConfigurationManager.HOME_DIR, is("homeDir"));
    assertThat(ConfigurationManager.HTTP_PORT, is("httpPort"));
    assertThat(ConfigurationManager.SERVICES_CONTEXT_ROOT, is("servicesContextRoot"));
    assertThat(ConfigurationManager.HOST, is("host"));
    assertThat(ConfigurationManager.PORT, is("port"));
    assertThat(ConfigurationManager.PROTOCOL, is("protocol"));
    assertThat(ConfigurationManager.TRUST_STORE, is("trustStore"));
    assertThat(ConfigurationManager.TRUST_STORE_PASS, is("trustStorePassword"));
    assertThat(ConfigurationManager.KEY_STORE, is("keyStore"));
    assertThat(ConfigurationManager.KEY_STORE_PASS, is("keyStorePassword"));
    assertThat(ConfigurationManager.SITE_NAME, is("id"));
    assertThat(ConfigurationManager.VERSION, is("version"));
    assertThat(ConfigurationManager.ORGANIZATION, is("organization"));
    assertThat(ConfigurationManager.CONTACT, is("contact"));
  }
}
