# Fast development build configuration
# Usage: mvn install -Dfast
#
# This configuration skips time-consuming checks for faster iteration:
# - Skips tests (use -DskipTests=false to run them)
# - Skips checkstyle
# - Skips dependency-check
# - Skips enforcer rules
# - Skips javadoc generation
# - Skips source jar generation

-DskipTests=true
-Dcheckstyle.skip=true
-Ddependency-check.skip=true
-Denforcer.skip=true
-Dmaven.javadoc.skip=true
-Dmaven.source.skip=true
-Dfmt.skip=true
