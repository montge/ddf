<features xmlns="http://karaf.apache.org/xmlns/features/v1.6.0"
          name="ddf-cxf-${project.version}">

    <!-- Repository references for dependencies -->
    <repository>mvn:ddf.features/kernel/${project.version}/xml/features</repository>
    <!-- Camel features for camel-cxf dependency -->
    <repository>mvn:ddf.features/camel-karaf/${project.version}/xml/features</repository>

    <!--
        DDF CXF 4.x Features

        These features provide Apache CXF 4.x with Jakarta EE namespace support
        for use in Apache Karaf. They replace the upstream CXF Karaf features
        which were removed in CXF 4.x.

        See: https://issues.apache.org/jira/browse/CXF-9086
    -->

    <!-- Jakarta EE API features (prerequisites) -->
    <!-- Using jakarta.annotation-api 2.1.1 for Camel 4.x compatibility
         Camel's camel-cxf-all imports jakarta.annotation;version="[2.0.0,3.0.0)"
         DDF bundles updated to accept [2.0,4) import range -->
    <feature name="jakarta-annotation" version="${project.version}" description="Jakarta Annotation API">
        <bundle>mvn:jakarta.annotation/jakarta.annotation-api/2.1.1</bundle>
    </feature>

    <feature name="jakarta-activation" version="${project.version}" description="Jakarta Activation API">
        <bundle>mvn:jakarta.activation/jakarta.activation-api/2.1.3</bundle>
        <bundle>mvn:org.eclipse.angus/angus-activation/2.0.2</bundle>
    </feature>

    <!-- JAXB 3.0.x for CXF 4.1.1 compatibility
         CXF 4.1.1 OSGi bundles import jakarta.xml.bind;version="[3,4)"
         Named jaxb-3 to avoid conflict with Camel's jakarta-xml-bind feature (JAXB 4.x) -->
    <feature name="jaxb-3" version="${project.version}" description="JAXB 3.x API for CXF">
        <feature>jakarta-activation</feature>
        <bundle>mvn:jakarta.xml.bind/jakarta.xml.bind-api/3.0.1</bundle>
        <bundle>mvn:org.glassfish.jaxb/jaxb-runtime/3.0.2</bundle>
        <bundle>mvn:org.glassfish.jaxb/jaxb-core/3.0.2</bundle>
        <bundle>mvn:com.sun.istack/istack-commons-runtime/4.1.2</bundle>
    </feature>

    <!-- Jakarta XML-WS feature with version 2.x APIs for CXF 4.1.1 compatibility
         CXF 4.1.1 bundles import jakarta.xml.soap;version="[2.0.0,3.0.0)"
         NOTE: JAXB comes from Camel (via camel-cxf) - DO NOT add jaxb-3 -->
    <feature name="jakarta-xml-ws" version="${project.version}" description="Jakarta XML Web Services API">
        <!-- JAXB provided by Camel's jakarta-xml-bind feature (4.x) -->
        <feature>jakarta-annotation</feature>
        <bundle>mvn:jakarta.xml.ws/jakarta.xml.ws-api/3.0.1</bundle>
        <bundle>mvn:jakarta.jws/jakarta.jws-api/3.0.0</bundle>
        <bundle>mvn:jakarta.xml.soap/jakarta.xml.soap-api/2.0.1</bundle>
    </feature>

    <feature name="jakarta-ws-rs" version="${project.version}" description="Jakarta RESTful Web Services API">
        <feature>jakarta-annotation</feature>
        <bundle>mvn:jakarta.ws.rs/jakarta.ws.rs-api/3.1.0</bundle>
        <bundle>mvn:jakarta.validation/jakarta.validation-api/3.0.2</bundle>
    </feature>

    <!-- CXF 4.x Core Feature
         Note: Version 3.6.9 is used to satisfy Camel's cxf-core version range requirement [3.6,3.7)
         The actual CXF implementation comes from Camel's camel-cxf-all bundle (CXF 4.1.1).
         DDF no longer installs its own cxf-core-all to avoid split-package conflicts.
         REQUIRES camel-cxf feature to provide org.apache.cxf package.
         NOTE: Uses JAXB 4.x from Camel (via camel-cxf) - DO NOT add jaxb-3 here as it causes
         uses constraint violations with Camel bundles. -->
    <feature name="cxf-core" version="3.6.9" description="Apache CXF 4.x Core">
        <!-- camel-cxf provides camel-cxf-all bundle which exports org.apache.cxf package
             AND provides JAXB 4.x dependency -->
        <feature>camel-cxf</feature>
        <feature>jakarta-annotation</feature>
        <feature>jakarta-activation</feature>

        <!-- Woodstox XML processor -->
        <bundle>mvn:org.codehaus.woodstox/stax2-api/4.2.2</bundle>
        <bundle>mvn:com.fasterxml.woodstox/woodstox-core/6.7.0</bundle>

        <!-- Apache XMLSchema -->
        <bundle>mvn:org.apache.ws.xmlschema/xmlschema-core/2.3.1</bundle>

        <!-- WSDL4J -->
        <bundle>wrap:mvn:wsdl4j/wsdl4j/1.6.3</bundle>

        <!-- Apache Neethi (WS-Policy) -->
        <bundle>mvn:org.apache.neethi/neethi/${wss4j.neethi.version}</bundle>

        <!-- CXF packages come from Camel's camel-cxf-all bundle.
             Do NOT install cxf-core-all here as it creates split-package conflict. -->
    </feature>

    <!-- CXF JAX-RS Feature -->
    <feature name="cxf-jaxrs" version="3.6.9" description="Apache CXF 4.x JAX-RS">
        <feature version="3.6.9">cxf-core</feature>
        <feature>jakarta-ws-rs</feature>
    </feature>

    <!-- CXF JAX-RS Feature (default version for unversioned references) -->
    <feature name="cxf-jaxrs" version="0.0.0" description="Apache CXF 4.x JAX-RS (default)">
        <feature version="3.6.9">cxf-jaxrs</feature>
    </feature>

    <!-- CXF JAX-WS Feature -->
    <feature name="cxf-jaxws" version="3.6.9" description="Apache CXF 4.x JAX-WS">
        <feature version="3.6.9">cxf-core</feature>
        <feature>jakarta-xml-ws</feature>
    </feature>

    <!-- CXF JAX-WS Feature (default version for unversioned references) -->
    <feature name="cxf-jaxws" version="0.0.0" description="Apache CXF 4.x JAX-WS (default)">
        <feature version="3.6.9">cxf-jaxws</feature>
    </feature>

    <!-- CXF SOAP Bindings Feature
         NOTE: org.apache.cxf.binding.soap package is provided by camel-cxf-all bundle.
         DO NOT install cxf-rt-bindings-soap bundle as it requires JAXB 3.x which conflicts
         with Camel's JAXB 4.x (causes uses constraint violations). -->
    <feature name="cxf-bindings-soap" version="3.6.9" description="Apache CXF 4.x SOAP Bindings">
        <feature version="3.6.9">cxf-core</feature>
        <feature>jakarta-xml-ws</feature>
        <!-- SOAP binding packages come from camel-cxf-all (via cxf-core -> camel-cxf) -->
    </feature>

    <!-- CXF JAXB Databinding Feature (Camel compatibility)
         NOTE: Uses JAXB 4.x from Camel (via cxf-core -> camel-cxf) -->
    <feature name="cxf-databinding-jaxb" version="3.6.9" description="Apache CXF 4.x JAXB Databinding">
        <feature version="3.6.9">cxf-core</feature>
        <!-- JAXB comes from Camel's jakarta-xml-bind feature (4.x) -->
    </feature>

    <!-- CXF HTTP Transport Feature -->
    <feature name="cxf-http" version="3.6.9" description="Apache CXF 4.x HTTP Transport">
        <feature version="3.6.9">cxf-core</feature>
        <feature>pax-web-http</feature>
    </feature>

    <!-- CXF HTTP Provider Feature (Camel compatibility alias) -->
    <feature name="cxf-http-provider" version="3.6.9" description="Apache CXF 4.x HTTP Provider">
        <feature version="3.6.9">cxf-http</feature>
    </feature>

    <!-- WSS4J 2.4.x Feature (Apache Web Services Security)
         Uses WSS4J 2.4.x for DDF's existing security code which uses javax APIs.
         WSS4J 4.0.x would require jakarta namespace migration.

         WSS4J 2.4.x dependencies:
         - OpenSAML 4.x: Required for org.opensaml.core.config package
         - joda-time: Required for date/time handling
         - java-support: Required by OpenSAML 4.x (Shibboleth library) -->
    <!-- NOTE: WSS4J bundles import jakarta.xml.bind with version [3.0,4.0) but can wire
         to JAXB 4.x from Camel since the APIs are compatible. DO NOT add jaxb-3 here
         as it causes uses constraint violations with Camel bundles. -->
    <feature name="wss4j" version="${project.version}" description="Apache WSS4J 2.4.x">
        <!-- JAXB comes from Camel (via camel-cxf) - DO NOT add jaxb-3 -->
        <!-- Guava required by OpenSAML 4.x (com.google.common.base package) -->
        <feature>guava</feature>

        <!-- Dropwizard Metrics 4.x required by OpenSAML 4.x (com.codahale.metrics package) -->
        <bundle>mvn:io.dropwizard.metrics/metrics-core/4.2.30</bundle>

        <!-- joda-time required by WSS4J 2.4.x and OpenSAML 4.x -->
        <bundle>mvn:joda-time/joda-time/${joda-time.version}</bundle>

        <!-- Shibboleth java-support required by OpenSAML 4.x -->
        <bundle>wrap:mvn:net.shibboleth.utilities/java-support/${java-support.version}</bundle>

        <!-- Cryptacular required by OpenSAML 4.x -->
        <bundle>wrap:mvn:org.cryptacular/cryptacular/1.2.4</bundle>

        <!-- OpenSAML 4.x ServiceMix bundle - required by WSS4J 2.4.x
             Provides org.opensaml.core.config and other OpenSAML packages -->
        <bundle>mvn:org.apache.servicemix.bundles/org.apache.servicemix.bundles.opensaml/${opensaml.osgi.version}</bundle>

        <!-- javax.mail needed by WSS4J 2.4.x (uses javax.mail, not jakarta.mail) -->
        <bundle>mvn:com.sun.mail/javax.mail/1.6.2</bundle>

        <!-- WSS4J 2.4.x bundles -->
        <bundle>mvn:org.apache.wss4j/wss4j-ws-security-common/${wss4j.version}</bundle>
        <bundle>mvn:org.apache.wss4j/wss4j-ws-security-dom/${wss4j.version}</bundle>
        <bundle>mvn:org.apache.wss4j/wss4j-ws-security-stax/${wss4j.version}</bundle>
        <bundle>mvn:org.apache.wss4j/wss4j-policy/${wss4j.version}</bundle>
        <bundle>mvn:org.apache.wss4j/wss4j-bindings/${wss4j.version}</bundle>

        <!-- Apache Santuario (XML Security) - use 2.3.x for WSS4J 2.4.x compatibility -->
        <bundle>mvn:org.apache.santuario/xmlsec/${xmlsec.version}</bundle>
    </feature>

    <!-- CXF WS-Security Feature
         Note: The cxf-rt-ws-security bundle has been removed because it imports OpenSAML 3.x
         packages which conflict with DDF's use of OpenSAML 4.x. DDF security code has been
         refactored to use:
         - AbstractSoapInterceptor instead of AbstractWSS4JInterceptor
         - Direct WSS4J 2.4.x APIs instead of CXF WS-Security wrappers
         - Simple token caching instead of CXF TokenStore -->
    <feature name="cxf-ws-security" version="3.6.9" description="Apache CXF WS-Security">
        <feature version="3.6.9">cxf-core</feature>
        <feature version="3.6.9">cxf-bindings-soap</feature>
        <feature>wss4j</feature>
        <!-- javax.* APIs for SAAJ/JAX-WS support -->
        <bundle>mvn:javax.xml.soap/javax.xml.soap-api/1.4.0</bundle>
        <!-- stax-ex required by saaj-impl (provides org.jvnet.staxex package) -->
        <bundle>mvn:org.jvnet.staxex/stax-ex/1.8.3</bundle>
        <!-- FastInfoset required by saaj-impl (provides com.sun.xml.fastinfoset.* packages) -->
        <bundle>mvn:com.sun.xml.fastinfoset/FastInfoset/2.1.1</bundle>
        <!-- SAAJ impl wrapped to fix self-import issue (imports its own package without version range) -->
        <bundle>wrap:mvn:com.sun.xml.messaging.saaj/saaj-impl/1.5.3$overwrite=merge&amp;Import-Package=com.sun.xml.messaging.saaj.util.stax;resolution:=optional,*</bundle>
        <bundle>mvn:javax.jws/javax.jws-api/1.1</bundle>
        <bundle>mvn:javax.xml.ws/jaxws-api/2.3.1</bundle>
        <!-- CXF 4.1.1 cxf-rt-security bundle (base security, no OpenSAML dependency)
             Note: Must use 4.1.1 to match camel-cxf-all's CXF package versions -->
        <bundle>mvn:org.apache.cxf/cxf-rt-security/${cxf.version}</bundle>
    </feature>

    <!-- CXF RS Security SAML Feature
         Note: DDF's SAML code has been refactored to use direct OpenSAML 4.x APIs,
         eliminating the dependency on CXF RS Security SAML bundles which require
         incompatible OpenSAML versions. This feature is a minimal stub. -->
    <feature name="cxf-rs-security-saml" version="3.6.9" description="Apache CXF RS Security SAML (Stub)">
        <feature version="3.6.9">cxf-jaxrs</feature>
        <feature version="3.6.9">cxf-ws-security</feature>
        <!-- JCache API and EHCache for SAML caching -->
        <bundle>mvn:javax.cache/cache-api/1.1.1</bundle>
        <bundle>mvn:org.ehcache/ehcache/3.10.8</bundle>
        <!-- Note: CXF RS Security SAML bundles removed - DDF now uses direct OpenSAML 4.x APIs -->
    </feature>

    <!-- CXF RS Security OAuth2 Feature -->
    <feature name="cxf-rs-security-oauth2" version="3.6.9" description="Apache CXF 4.x RS Security OAuth2">
        <feature version="3.6.9">cxf-jaxrs</feature>
        <!-- JAXB is provided by Camel's jakarta-xml-bind feature (JAXB 4.x via camel-cxf) -->
        <!-- CXF JOSE bundles for JWT/JWS/JWE support (required by OAuth2) -->
        <bundle>mvn:org.apache.cxf/cxf-rt-rs-security-jose/${cxf.version}</bundle>
        <bundle>mvn:org.apache.cxf/cxf-rt-rs-security-jose-jaxrs/${cxf.version}</bundle>
        <!-- Standalone CXF OAuth2 bundle - provides org.apache.cxf.rs.security.oauth2.* packages
             that are NOT exported by camel-cxf-all -->
        <bundle>mvn:org.apache.cxf/cxf-rt-rs-security-oauth2/${cxf.version}</bundle>
    </feature>

    <!-- Combined CXF Feature (convenience) -->
    <feature name="cxf" version="3.6.9" description="Apache CXF 4.x Complete">
        <feature version="3.6.9">cxf-jaxrs</feature>
        <feature version="3.6.9">cxf-jaxws</feature>
        <feature version="3.6.9">cxf-http</feature>
    </feature>

    <!-- CXF with Security (convenience) -->
    <feature name="cxf-secure" version="${project.version}" description="Apache CXF 4.x with Security">
        <feature version="3.6.9">cxf</feature>
        <feature version="3.6.9">cxf-ws-security</feature>
        <feature version="3.6.9">cxf-rs-security-saml</feature>
        <feature version="3.6.9">cxf-rs-security-oauth2</feature>
    </feature>

    <!-- CXF Commands Feature (Karaf commands for CXF management)
         Note: CXF 4.x removed the cxf-karaf-commands artifact, so this is now a stub feature -->
    <feature name="cxf-commands" version="3.6.9" description="Apache CXF 4.x Karaf Commands">
        <feature version="3.6.9">cxf-core</feature>
    </feature>

